<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: not the device key (a copy could impersonate
     this phone to every trusted laptop), not the trust list, not partial
     downloads. See DECISIONS.md, "Device key on Android". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
